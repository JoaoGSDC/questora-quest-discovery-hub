# Gemini (Google AI Studio). Sem key = tutor só com gabarito local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Twitch OAuth (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Opcional: se vazio, usa a origem atual (localhost ou Vercel) + /api/twitch/callback
# TWITCH_REDIRECT_URI=https://seu-app.vercel.app/api/twitch/callback

# Turso (https://turso.tech) — obrigatório em produção / Vercel
# Local sem Turso: deixe comentado (usa file:./data/questora.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
