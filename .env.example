# Gemini (Google AI Studio). Sem key = tutor só com gabarito local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Twitch OAuth (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# URL pública canônica (callback Twitch). Na Vercel use a URL de produção:
NEXT_PUBLIC_APP_URL=https://questora-quest-discovery-hub.vercel.app
# Cadastre no console Twitch exatamente:
#   https://questora-quest-discovery-hub.vercel.app/api/twitch/callback

# Turso (https://turso.tech) — obrigatório na Vercel
# Local sem Turso: deixe vazio (usa file:./data/questora.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
