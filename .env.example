# Gemini (Google AI Studio). Sem key = tutor só com gabarito local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Twitch OAuth (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Não use TWITCH_REDIRECT_URI: o app monta sozinho {origem}/api/twitch/callback
# Cadastre no console Twitch:
#   http://localhost:3000/api/twitch/callback
#   https://seu-app.vercel.app/api/twitch/callback

# Turso (https://turso.tech) — obrigatório na Vercel
# Local sem Turso: deixe vazio (usa file:./data/questora.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
